# LiveWalk mobile runtime config
# app.config.ts reads this value into Expo extra.apiBaseUrl.
# Change it before exporting/building to point the app at a different backend.
EXPO_PUBLIC_API_BASE_URL=https://rendezvous-livewalk-api.webpeter.com

# Optional CI/build alias. If both are set, LIVEWALK_API_BASE_URL wins.
# LIVEWALK_API_BASE_URL=https://rendezvous-livewalk-api.webpeter.com

# Public LiveKit signaling endpoint. app.config.ts exposes it as extra.livekitWsUrl
# for the client runtime. It identifies the LiveKit server but does not authorize a session.
# Keep all server credentials and signing material out of this app.
LIVEKIT_WS_URL=wss://your-livekit-project.livekit.cloud

# Mapbox public tokens for rendering live Traveler maps.
# Web builds use MAPBOX_TOKEN_WEB; Android and iOS builds use MAPBOX_TOKEN_MOBILE.
MAPBOX_TOKEN_WEB=pk.your_mapbox_public_token_here
MAPBOX_TOKEN_MOBILE=pk.your_mapbox_public_token_here
