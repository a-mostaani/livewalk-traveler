{
  "name": "livewalk-traveler",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "export:web": "expo export --platform web",
    "ios": "expo run:ios",
    "check:config": "expo config --type public",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:mapbox": "node scripts/check-mapbox.mjs",
    "check:live-session": "node scripts/check-live-session.mjs",
    "check:request-state": "node scripts/check-request-state.mjs",
    "check:cancellation": "node scripts/check-cancellation.mjs",
    "check:session-sync": "node scripts/check-session-sync.mjs",
    "web:dev": "vite --config web/vite.config.ts",
    "web:typecheck": "tsc --noEmit -p web/tsconfig.json",
    "web:test": "vitest run --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts && node scripts/check-web-livekit-build.mjs",
    "web:check-livekit": "node scripts/check-web-livekit-build.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "expo": "^53.0.0",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.2",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "livekit-client": "^2.21.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "~19.0.10",
    "@types/react-dom": "~19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
