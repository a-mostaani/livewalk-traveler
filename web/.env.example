# LivelyWalk Traveler web runtime config
# Vite reads VITE_-prefixed variables at build time (root: web/, so this file
# lives here rather than at the repo root, which is mobile's Expo config).

# Backend base URL. Falls back to the production API if unset.
VITE_LIVEWALK_API_BASE_URL=https://rendezvous-livewalk-api.webpeter.com

# Mapbox public token for the place search box and the live session's guide-location map.
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Public LiveKit signaling endpoint for the live session's video/audio.
# Identifies the LiveKit server but does not authorize a session - keep all
# server credentials and signing material out of this app (same rule as mobile's).
VITE_LIVEKIT_WS_URL=wss://your-livekit-project.livekit.cloud
